{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Nhật Ký Cây Lúa",
	"version": "0.1.0",
	"identifier": "com.taur-rice-diary.dev",
	"build": {
		"frontendDist": "../out",
		"devUrl": "http://localhost:1420",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"title": "Nhật Ký Cây Lúa",
				"width": 800,
				"height": 600,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"assetProtocol": {
				"enable": true,
				"scope": ["**", "$APPLOCALDATA/selected-images/**/*"]
			},
			"csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' https://serverless.roboflow.com"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": ["./database/*", "./database/migrations/*", "models/**/*"],
		"android": { "debugApplicationIdSuffix": ".debug" }
	}
}
